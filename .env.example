# Buzz is optional during provisioning. Set both values to enable its runtime environment.
BUZZ_RELAY_URL=https://relay.example.example
BUZZ_PRIVATE_KEY=nsec1_replace_me
# BUZZ_AUTH_TAG=optional_owner_attestation
BUZZ_SOURCE_REVISION=dad5a33865fc81a2e55b3b60746632f615ec1e3a
BUZZ_SPRIG_RELEASE_TAG=sprig-latest

# Both values are required to configure Git inside the box.
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="you@example.com"

# ai-jail integration. These override the corresponding Ansible defaults.
AI_JAIL_ENABLED=true
AI_JAIL_AUR_PACKAGE=ai-jail-bin
AI_JAIL_NETWORK=true
AI_JAIL_AGENT_STATE=true
AI_JAIL_DENY_HOST_HOME=true
# Colon-separated paths hidden from every managed harness.
AI_JAIL_DENY_PATHS=/run/host:/usr/bin/distrobox-host-exec:/run/podman:/var/run/docker.sock:/run/docker.sock

# Container runtime constraints. Changing these requires box recreation.
DISTROBOX_PIDS_LIMIT=512
DISTROBOX_MEMORY=8g
DISTROBOX_CPUS=4
DISTROBOX_ALLOW_HOST_LOOPBACK=false
DISTROBOX_NETWORK_BACKEND=pasta
