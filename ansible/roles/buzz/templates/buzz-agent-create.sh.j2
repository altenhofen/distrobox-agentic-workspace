#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: buzz-agent-create AGENT_COMMAND [ARG ...]\n' >&2
}

[[ $# -ge 1 ]] || { usage; exit 64; }
agent_command=$1
shift

# `codex` is the interactive TUI; Buzz ACP needs the published stdio adapter.
if [[ $agent_command == codex ]] && command -v codex-acp >/dev/null 2>&1; then
  agent_command=codex-acp
fi

if [[ $agent_command == */* ]]; then
  [[ -x $agent_command ]] || {
    printf 'buzz-agent-create: command is not executable: %s\n' "$agent_command" >&2
    exit 69
  }
else
  resolved_command=$(command -v -- "$agent_command") || {
    printf 'buzz-agent-create: command was not found: %s\n' "$agent_command" >&2
    exit 69
  }
  agent_command=$resolved_command
fi

for argument in "$@"; do
  if [[ $argument == *,* ]]; then
    printf 'buzz-agent-create: arguments cannot contain commas: %s\n' "$argument" >&2
    exit 64
  fi
done

env_file=${ADS_BUZZ_ENV_FILE:-"$HOME/.ads-buzz-env"}
if [[ ! -r "$env_file" ]]; then
  printf 'buzz-agent-create: Buzz credentials are not configured\n' >&2
  exit 78
fi
. "$env_file"
: "${BUZZ_RELAY_URL:?buzz-agent-create: BUZZ_RELAY_URL is required}"
: "${BUZZ_PRIVATE_KEY:?buzz-agent-create: BUZZ_PRIVATE_KEY is required}"

# buzz-acp speaks WebSocket to the relay; accept the HTTP(S) form used by the
# regular Buzz CLI and translate it only for the ACP child process.
case "$BUZZ_RELAY_URL" in
  https://*) BUZZ_RELAY_URL="wss://${BUZZ_RELAY_URL#https://}" ;;
  http://*) BUZZ_RELAY_URL="ws://${BUZZ_RELAY_URL#http://}" ;;
esac
export BUZZ_RELAY_URL

export BUZZ_ACP_AGENT_COMMAND=$agent_command
if (( $# > 0 )); then
  printf -v BUZZ_ACP_AGENT_ARGS '%s,' "$@"
  export BUZZ_ACP_AGENT_ARGS=${BUZZ_ACP_AGENT_ARGS%,}
else
  unset BUZZ_ACP_AGENT_ARGS 2>/dev/null || true
fi

exec buzz-acp
