#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: buzz-agent-create --list\n       buzz-agent-create AGENT_NAME\n' >&2
}

list_agents() {
{% for agent_name in ads_buzz_agent_allowlist.keys() | sort %}
  printf '%s\n' {{ agent_name | quote }}
{% endfor %}
}

if [[ ${1:-} == --list ]]; then
  [[ $# -eq 1 ]] || { usage; exit 64; }
  list_agents
  exit 0
fi

[[ $# -eq 1 ]] || { usage; exit 64; }
agent_name=$1

case "$agent_name" in
{% for agent_name, agent in ads_buzz_agent_allowlist | dictsort %}
  {{ agent_name | quote }})
    agent_command={{ agent.command | quote }}
    agent_args={{ agent.args | join(',') | quote }}
    ;;
{% endfor %}
  *)
    printf 'buzz-agent-create: agent is not allowlisted: %s\n' "$agent_name" >&2
    printf 'Permitted agents:\n' >&2
    list_agents >&2
    exit 77
    ;;
esac

env_file=${ADS_BUZZ_ENV_FILE:-"$HOME/.ads-buzz-env"}
if [[ ! -r "$env_file" ]]; then
  printf 'buzz-agent-create: Buzz credentials are not configured\n' >&2
  exit 78
fi
# shellcheck disable=SC1090
. "$env_file"
: "${BUZZ_RELAY_URL:?buzz-agent-create: BUZZ_RELAY_URL is required}"
: "${BUZZ_PRIVATE_KEY:?buzz-agent-create: BUZZ_PRIVATE_KEY is required}"

export BUZZ_ACP_AGENT_COMMAND=$agent_command
if [[ -n "$agent_args" ]]; then
  export BUZZ_ACP_AGENT_ARGS=$agent_args
else
  unset BUZZ_ACP_AGENT_ARGS 2>/dev/null || true
fi

exec buzz-acp
